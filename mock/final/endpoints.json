    "statement.week.get":    {"method": "POST", "path": "/statement/week/get",    "by": ["card"]},
    "statement.week.decide": {"method": "POST", "path": "/statement/week/decide", "by": ["card", "week"]},
    "statement.week.change": {"method": "POST", "path": "/statement/week/change", "by": ["card", "week"], "record": "statement_week_change"},
    "contact.email.get":     {"method": "POST", "path": "/contact/email/get",     "by": ["customer"]},
    "statement.pdf.send":    {"method": "POST", "path": "/statement/pdf/send",    "by": ["customer"], "record": "statement_pdf_sent"}
  },

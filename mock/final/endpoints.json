{
  "_note": "From the bank's service contract (sources/documents/2026-10-01-service-contract.md): every service is POST <base>/<service name> with {data:{...}, call:{...}}. 'by' = fields that select the canned answer; 'extra' = other request fields (used by the self-test); 'required' = fields whose absence is a 400; 'unknown' = answer for a customer/card/week that is not in the test file (section 6).",
  "base_path": "/voice/v1",
  "tenant": "freyabank",
  "aliases": {"customer": ["customerNo"], "card": ["cardNumber"], "week": ["newStatementWeek"]},
  "placeholders": {"customerNo": "90000001", "cardNumber": "540000******1234", "newStatementWeek": "3"},
  "token": {"path": "/oauth2/token", "access_token": "mock-access-token", "expires_in": 1800},
  "services": {
    "cards.list": {"path": "/cards.list", "by": ["customer"], "extra": {"aiFlow": "CardOps"},
      "required": [["customerNo", "customer number cannot be empty"]],
      "unknown": [404, "FB_IVR_CHANNEL_102", "WARNING", "Müşteriye ait geçerli kart bilgisi bulunamadı."]},
    "cards.balance": {"path": "/cards.balance", "by": ["card"],
      "required": [["cardNumber", "card number cannot be empty"]],
      "unknown": [404, "FB_IVR_CHANNEL_120", "WARNING", "Kart bakiye servisi hatası: kart bulunamadı"]},
    "statement.week.get": {"path": "/statement.week.get", "by": ["card"],
      "required": [["cardNumber", "card number cannot be empty"]],
      "unknown": [404, "FB_IVR_CHANNEL_121", "WARNING", "Kart bulunamadı"]},
    "statement.week.decide": {"path": "/statement.week.decide", "by": ["card", "week"], "extra": {"statementDay": 5},
      "required": [["cardNumber", "card number cannot be empty"], ["newStatementWeek", "new statement week cannot be empty"]],
      "unknown": [400, "INVALID_ARGUMENTS_ERROR", "ERROR", "invalid arguments"]},
    "statement.week.change": {"path": "/statement.week.change", "by": ["card", "week"], "extra": {"statementDay": 5}, "record": "statement_week_change",
      "record_data": {"customerNo": "@customer", "cardNumber": "{{cardNumber}}", "newStatementWeek": "{{newStatementWeek}}"},
      "required": [["cardNumber", "card number cannot be empty"], ["newStatementWeek", "new statement week cannot be empty"]],
      "unknown": [400, "INVALID_ARGUMENTS_ERROR", "ERROR", "invalid arguments"]},
    "contact.email.get": {"path": "/contact.email.get", "by": ["customer"], "extra": {"intAddressInfoType": "E"},
      "required": [["customerNo", "customer number cannot be empty"], ["intAddressInfoType", "intAddressInfoType cannot be empty"]],
      "unknown": [400, "INVALID_ARGUMENTS_ERROR", "ERROR", "invalid arguments"]},
    "statement.pdf.send": {"path": "/statement.pdf.send", "by": ["customer"], "record": "statement_pdf_sent",
      "extra": {"cardNumber": "540000******0000", "currencyType": "TL", "statementDate": "05.10.2026", "emailAddress": "ornek@freyabank.example"},
      "record_data": {"customerNo": "@customer", "cardNumber": "{{cardNumber}}", "currencyType": "{{currencyType}}", "statementDate": "{{statementDate}}", "emailAddress": "{{emailAddress}}"},
      "required": [["customerNo", "customer number cannot be empty"], ["cardNumber", "card number cannot be empty"], ["currencyType", "currency type cannot be empty"], ["statementDate", "statement date cannot be empty"], ["emailAddress", "email address cannot be empty"]],
      "unknown": [404, "FB_IVR_CHANNEL_107", "WARNING", "Pdf dokümanı bulunamadı"]}
  },
  "openapi_file": "mock/final/bank.openapi.json"
}

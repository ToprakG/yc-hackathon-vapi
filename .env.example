# Builder. If OPENAI_API_KEY is set, the builder uses OpenAI.
# Otherwise the builder uses Vapi chat (POST /chat) with VAPI_API_KEY.
# Set BUILDER_PROVIDER=openai or BUILDER_PROVIDER=vapi to force one.
OPENAI_API_KEY=
VAPI_API_KEY=

BUILDER_MODEL=gpt-4o-mini
VAPI_BASE_URL=https://api.vapi.ai

# Model and voice written onto the assistant the adapter publishes.
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o-mini
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot

# Optional webhook for function tools. Omitted when empty.
VAPI_TOOL_SERVER_URL=

# --- agentforge ---
ANTHROPIC_API_KEY=
TOOLS_BASE_URL=
# "provider:model" or a bare model name (gpt-* -> openai, claude-* -> anthropic).
# BUILDER_MODEL above is shared with track_a. The judge must use a different provider than the agent.
AGENT_MODEL=openai:gpt-4o-mini
JUDGE_MODEL=anthropic:claude-sonnet-5-5
SIMULATOR_MODEL=openai:gpt-4o-mini

# --- freya ---
FREYA_API_KEY=
# Required as a query/body param by most Freya endpoints.
FREYA_WORKSPACE_ID=
FREYA_BASE_URL=https://app.freyavoice.ai/api/v2

# Conversations in flight per suite.
SIM_CONCURRENCY=12
# 1 = one judge call per conversation (fast); 0 = one call per check (closest to Freya).
JUDGE_BATCH=1
